{
  "name": "webrtc-player",
  "version": "1.0.0",
  "description": "A WebRTC player",
  "main": "dist/WebRTCPlayer.bundle.js",
  "types": "dist/types/src/js/webRTCPlayer.d.ts",
  "scripts": {
    "start": "webpack serve --config=webpack.config.dev.js --open",
    "clean": "rimraf dist",
    "build:types": "tsc --emitDeclarationOnly --declarationDir ./dist/types",
    "build-prod": "pnpm run clean && pnpm run build:types && webpack --config=webpack.config.prod.js",
    "build-dev": "webpack --config=webpack.config.dev.js",
    "prepublishOnly": "npm run build-prod",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "WebRTC",
    "WebRtc Player",
    "rtc player",
    "webrtc player"
  ],
  "author": "Hiren Rathod",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@babel/core": "^7.21.0",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "babel-loader": "^9.1.2",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.2",
    "css-minimizer-webpack-plugin": "^4.2.2",
    "dotenv-webpack": "^8.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-webpack-plugin": "^5.0.2",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^17.0.0",
    "html-webpack-plugin": "^5.5.0",
    "json-loader": "^0.5.7",
    "raw-loader": "^4.0.2",
    "rimraf": "^6.1.2",
    "sass": "^1.97.2",
    "sass-loader": "^16.0.6",
    "style-loader": "^3.3.1",
    "terser-webpack-plugin": "^5.3.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.11.1",
    "webpack-merge": "^5.8.0"
